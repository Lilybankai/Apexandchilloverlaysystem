{
  "name": "apex-overlay-system",
  "//name": "The npm package name predates the rename to Apex AIO System and stays put: Electron derives the userData path from it.",
  "version": "0.93.0",
  "private": true,
  "description": "Apex AIO System - Apex & Chill Racing League all-in-one rFactor2 / Le Mans Ultimate telemetry suite for live streams, with an Electron desktop control panel.",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server/index.js",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "app:dist": "npm run build && npm run oauth:bake && npm run release:notes && electron-builder --win && npm run oauth:verify",
    "oauth:bake": "node scripts/write-oauth-client.js",
    "oauth:verify": "node scripts/verify-oauth-baked.js",
    "prerelease": "node scripts/check-changelog.js",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
