    "test:tour": "node scripts/test-tour.js",
    "test:schedule": "node scripts/test-schedule.js",
    "test:ingame": "node scripts/test-ingame-layout.js",
    "test:docking": "node scripts/test-docking.js",
    "test:mfdui": "node scripts/test-mfd-ui.js",
    "test:raster": "node scripts/test-raster.js",
    "test:accent": "node scripts/test-accent-containment.js",
    "test:pitcursor": "node scripts/test-pitcursor.js",
    "test:damage": "node scripts/test-damage.js",
    "test:radar": "node scripts/test-radar.js",
    "test:refpace": "node scripts/test-referencepace.js",
    "test:session-headline": "node scripts/test-session-headline.js",
    "test:standings": "node scripts/test-standings.js",
    "test:paceavg": "node scripts/test-paceavg.js",
    "test:speedunit": "node scripts/test-speedunit.js",
    "test:tempunit": "node scripts/test-tempunit.js",
    "test:speedo": "node scripts/test-speedo.js",
    "test:speedo-designs": "node scripts/test-speedo-designs.js",
    "test:speedo-lmp2": "node scripts/test-speedo-lmp2.js",
    "test:carclass-ui": "node scripts/test-carclass-ui.js",
    "test:tyres": "node scripts/test-tyres.js",
    "test:updatechannel": "node scripts/test-updatechannel.js",
    "test:updatecache": "node scripts/test-updatecache.js",
    "test:startup": "node scripts/test-startup.js",
    "bench": "npm run build && node scripts/bench.js",
    "test:bench": "node scripts/test-bench.js",
    "test:changelog": "node scripts/test-changelog.js",
    "test:chat": "node scripts/test-chat.js",
    "test:streambot": "node scripts/test-streambot.js",
    "test:trackmap": "node scripts/test-trackmap.js",
    "test:bundledmaps": "node scripts/test-bundled-trackmaps.js",
    "trackmaps:import": "npm run build && node scripts/import-trackmaps.js",
    "test:tracklimits": "node scripts/test-tracklimits.js",
    "test:racecontrol": "node scripts/test-racecontrol.js",
    "test:triggers": "node scripts/test-triggers.js",
    "test:commands": "node scripts/test-commands.js",
    "test:engineer-queue": "node scripts/test-engineer-queue.js",
    "test:engineer-summary": "node scripts/test-engineer-summary.js",
    "test:bundledassets": "node scripts/test-bundledassets.js",
    "stage:bundled": "node scripts/stage-bundled.js",
    "build:repair": "node scripts/build-repair-tool.js",
    "record": "node scripts/record-session.js",
    "test:tracelimits": "node scripts/test-tracelimits.js",
    "test:lmubinder": "node scripts/test-lmubinder.js",
    "test:plugininstall": "node scripts/test-plugininstall.js",
    "test:gamepad": "node scripts/test-gamepad-rescan.js",
    "reference-times": "node scripts/fetch-reference-times.js",
    "reference-times:check": "node scripts/fetch-reference-times.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rfactor2",
    "le-mans-ultimate",
    "telemetry",
    "overlay",
    "obs",
    "sim-racing",
    "websocket",
