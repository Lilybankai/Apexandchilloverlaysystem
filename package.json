{
  "name": "apex-overlay-system",
  "version": "0.52.0",
  "private": true,
  "description": "Apex & Chill Racing League — lightweight rFactor2 / Le Mans Ultimate telemetry overlay system for live streams (telemetry shared-memory -> WebSocket -> OBS browser-source overlays), with an optional Electron desktop control panel + installer.",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server/index.js",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "app:dist": "npm run build && npm run oauth:bake && electron-builder --win && npm run oauth:verify",
    "oauth:bake": "node scripts/write-oauth-client.js",
    "oauth:verify": "node scripts/verify-oauth-baked.js",
    "release": "npm run build && npm run oauth:bake && electron-builder --win && npm run oauth:verify && electron-builder --win --publish always",
    "icons": "node scripts/make-icons.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\"",
    "test:delta": "node scripts/test-pacedelta.js",
    "test:fuel": "node scripts/test-fuel.js",
    "test:multiclass": "node scripts/test-multiclass.js",
    "test:motion": "node scripts/test-motion.js",
    "test:chassis": "node scripts/test-chassis.js",
    "test": "npm run build && npm run test:delta && npm run test:fuel && npm run test:multiclass && npm run test:motion && npm run test:chassis && npm run test:tyres && npm run test:damage && npm run test:radar && npm run test:pitcursor && npm run test:tracklimits && npm run test:tracelimits && npm run test:mfd && npm run test:auth && npm run test:laplog && npm run test:lapupload && npm run test:refpace && npm run test:lmubinder && npm run test:panel-parity && npm run test:session-headline && npm run test:carclass-ui && npm run test:chat",
    "test:auth": "node scripts/test-auth.js",
    "test:laplog": "node scripts/test-laplog.js",
    "test:lapupload": "node scripts/test-lapupload.js",
    "test:mfd": "node scripts/test-mfd.js",
    "test:panel-parity": "node scripts/test-panel-parity.js",
    "test:pitcursor": "node scripts/test-pitcursor.js",
    "test:damage": "node scripts/test-damage.js",
    "test:radar": "node scripts/test-radar.js",
    "test:refpace": "node scripts/test-referencepace.js",
    "test:session-headline": "node scripts/test-session-headline.js",
    "test:carclass-ui": "node scripts/test-carclass-ui.js",
    "test:tyres": "node scripts/test-tyres.js",
    "test:chat": "node scripts/test-chat.js",
    "test:tracklimits": "node scripts/test-tracklimits.js",
    "test:tracelimits": "node scripts/test-tracelimits.js",
    "test:lmubinder": "node scripts/test-lmubinder.js",
    "reference-times": "node scripts/fetch-reference-times.js",
    "reference-times:check": "node scripts/fetch-reference-times.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rfactor2",
    "le-mans-ultimate",
    "telemetry",
    "overlay",
    "obs",
    "sim-racing",
    "websocket",
    "electron"
  ],
  "author": "Apex & Chill Racing League",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.apexandchill.overlaysystem",
    "productName": "Apex Overlay System",
    "publish": {
      "provider": "github",
      "owner": "Lilybankai",
      "repo": "Apexandchilloverlaysystem",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "overlay/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apex Overlay System"
    }
  }
}
