# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Electron installer output
release/

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime config overrides
.env
.env.local
config.local.json

# Google OAuth desktop client, baked into the build by scripts/write-oauth-client.js.
# Ships inside the package (it must, or YouTube linking only works on the build
# machine) but never in this public repo, where scanners auto-revoke it.
electron/oauth-client.generated.json

# Local screenshots / scratch — the reference captures, clipboard dumps, sound
# and model files that pile up in the working copy while a widget is being built.
#
# Root-scoped on purpose. Every asset the app actually ships lives under build/,
# electron/ or overlay/, and the repo root holds nothing but text config — so
# anchoring these to the root catches the scratch without ever hiding a real one.
# Both cases are listed because a clone on Linux matches them case-sensitively.
/*.png
/*.PNG
/*.jpg
/*.JPG
/*.jpeg
/*.gif
/*.webp
/*.mp3
/*.wav
/*.stl
/*.STL

# Local MCP server config — editor tooling, not part of the app.
.mcp.json
